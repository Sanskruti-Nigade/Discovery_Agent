# Name shown next to the logo in the top bar
VITE_APP_NAME=Discovery Agent
# Logo file in ui/public (use the reversed/white ServiceNow logo for the dark header)
VITE_LOGO_URL=/servicenow-logo.svg
# Dev-proxy target for /api and /lib (frontend/app.py)
VITE_API_TARGET=http://localhost:8080
# Schema-mapping API. Empty = same server as the UI. Set it when mapping/ runs as its own service
# (uvicorn mapping.main:app --port 8001), and add the UI origin to that service's CORS_ALLOW_ORIGINS.
VITE_MAPPING_API_BASE=
